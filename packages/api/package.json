{
  "name": "@maison/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@maison/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "check-types": "tsc -p tsconfig.config.json --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maison/auth": "workspace:*",
    "@maison/email": "workspace:*",
    "@maison/payments": "workspace:*",
    "@maison/db": "workspace:*",
    "@trpc/server": "^11.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.34.3",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@maison/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
