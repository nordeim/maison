{
  "name": "@maison/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@maison/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "check-types": "tsc -p tsconfig.config.json --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^19.2.7",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@maison/eslint-config": "workspace:*",
    "@maison/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
