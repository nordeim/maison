{
  "name": "@maison/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@maison/source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "@maison/source": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "check-types": "tsc -p tsconfig.config.json --noEmit && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maison/db": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "resend": "^6.17.0"
  },
  "devDependencies": {
    "@maison/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
