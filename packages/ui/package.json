{
  "name": "@maison/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./globals": {
      "@maison/source": "./src/globals.css",
      "default": "./src/globals.css"
    },
    "./tokens/colors.css": {
      "@maison/source": "./src/tokens/colors.css",
      "default": "./src/tokens/colors.css"
    },
    "./tokens/typography.css": {
      "@maison/source": "./src/tokens/typography.css",
      "default": "./src/tokens/typography.css"
    },
    "./tokens/motion.css": {
      "@maison/source": "./src/tokens/motion.css",
      "default": "./src/tokens/motion.css"
    },
    "./tokens/spacing.css": {
      "@maison/source": "./src/tokens/spacing.css",
      "default": "./src/tokens/spacing.css"
    },
    "./fonts/cormorant": {
      "@maison/source": "./src/fonts/cormorant/cormorant.css",
      "default": "./src/fonts/cormorant/cormorant.css"
    },
    "./fonts/inter": {
      "@maison/source": "./src/fonts/inter/inter.css",
      "default": "./src/fonts/inter/inter.css"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@maison/typescript-config": "workspace:*",
    "typescript": "^5.9.0"
  }
}
