# ══════════════════════════════════════════════════════════════════
# MAISON — Environment Variables Reference
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# See PROJECT-ARCHITECTURE.md §9.2 for full documentation.
# ══════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://maison.jesspete.shop

# ─── Database (Neon PostgreSQL in prod, Docker locally) ────────────
# Pooled connection — for all application queries (Neon PgBouncer in prod)
DATABASE_URL=postgresql://maison:maison_local_dev@localhost:5432/maison_dev

# Direct / unpooled connection — ONLY for migrations and seeding
# In production: use Neon's direct connection string (no -pooler suffix)
DATABASE_URL_UNPOOLED=postgresql://maison:maison_local_dev@localhost:5432/maison_dev

# ─── Authentication (Better Auth) ──────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
# For production: https://maison.jesspete.shop
BETTER_AUTH_URL=https://maison.jesspete.shop

# Google OAuth provider (Phase 2)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth provider (Phase 2)
# Create at: https://developer.apple.com/account/resources/identifiers/list
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# ─── Stripe ────────────────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Sanity CMS ────────────────────────────────────────────────────
# Create project at: https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Read token (server-side only — never expose publicly)
SANITY_API_TOKEN=your-sanity-read-token
# Webhook secret for ISR revalidation (Sanity Cloud → /api/webhooks/sanity)
SANITY_WEBHOOK_SECRET=your-sanity-webhook-secret

# ─── Email (Resend) ────────────────────────────────────────────────
# Get API key at: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=hello@maison-living.com

# ─── Background Jobs (Trigger.dev v4) ──────────────────────────────
# Get at: https://cloud.trigger.dev/projects
TRIGGER_SECRET_KEY=tr_dev_...

# ─── Redis (Upstash) — rate limiting, idempotency keys ─────────────
# Create free Redis at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Error Tracking (Sentry) — OPTIONAL ────────────────────────────
# Sentry is optional — if unset or placeholder, the app runs without error tracking.
# Get your DSN at: https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN=https://<key>@sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@sentry.io/<project>
# SENTRY_AUTH_TOKEN=sntrys_...  # CI only — source map uploads

# ─── Analytics (PostHog) ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Logging (Axiom) — OPTIONAL ────────────────────────────────────
AXIOM_TOKEN=xaat-...
AXIOM_DATASET=maison-logs

# ─── Cloudflare Images / R2 ────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_IMAGES_TOKEN=your-images-token
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=maison-media
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_CLOUDFLARE_IMAGES_URL=https://imagedelivery.net/your-account-hash

# ─── Klaviyo (Marketing email — Phase 2) ───────────────────────────
# KLAVIYO_API_KEY=your-klaviyo-api-key
# KLAVIYO_LIST_ID=your-newsletter-list-id

# ─── Vercel (CI/CD only — do not set locally) ──────────────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─── Neon API (CI/CD only — branch management) ─────────────────────
# NEON_API_KEY=
# NEON_PROJECT_ID=
